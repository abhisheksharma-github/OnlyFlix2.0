# OnlyFlix 2.0 — Environment Configuration
# Copy to .env and fill in your values. Never commit this file.

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Neon Serverless PostgreSQL ───────────────────────────────────────────────
# Dual-URL architecture required for Prisma + PgBouncer pooling:
#
#  DATABASE_URL  → Pooled connection via PgBouncer (used by the running app)
#                  Format: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?pgbouncer=true&connect_timeout=10
#
#  DIRECT_URL    → Direct (non-pooled) connection (used ONLY by Prisma CLI for
#                  migrations, schema pushes, and introspection)
#                  Format: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?connect_timeout=10
#
# Get both URLs from your Neon project dashboard → Connection Details → toggle "Pooled connection"
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?pgbouncer=true&connect_timeout=10"
DIRECT_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?connect_timeout=10"

# ─── TMDB ─────────────────────────────────────────────────────────────────────
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_v3_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate a strong secret: node -e "require('crypto').randomBytes(64).toString('hex')|pbcopy"
JWT_SECRET=replace_with_at_least_64_char_random_hex_string
JWT_EXPIRES_IN=7d
COOKIE_MAX_AGE_MS=604800000

# ─── CORS ─────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
