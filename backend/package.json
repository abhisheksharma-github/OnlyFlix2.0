{
  "name": "onlyflix-backend",
  "version": "1.0.0",
  "description": "OnlyFlix 2.0 — Express API gateway + Neon PostgreSQL backend",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "postinstall": "prisma generate && prisma db push",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "prisma": {
    "seed": "node prisma/seed.js",
    "schema": "prisma/schema.prisma"
  },
  "author": "OnlyFlix Dev Team",
  "license": "ISC",
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/client": "^5.22.0",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.4",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "node-cache": "^5.1.2",
    "ws": "^8.18.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "nodemon": "^3.0.3",
    "prisma": "^5.22.0"
  }
}
